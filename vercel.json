{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "functions": {
    "api/index.php": {
      "runtime": "@vercel/go",
      "memory": 1024,
      "maxDuration": 60
    }
  }
}